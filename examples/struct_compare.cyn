// struct_compare.cyn — Comparación de structs en todas sus formas.
//
//   bun src/run.ts examples/struct_compare.cyn demos/struct_compare.wasm
//   wasmtime demos/struct_compare.wasm
//
// Cubre:
//   1. Structs con campos primitivos  → == / !=
//   2. Structs con strings            → == / !=
//   3. Structs anidados               → == / != (recursivo)
//   4. Structs con arrays inline      → == / != (elemento por elemento)
//   5. nulls dentro de structs        → == / !=
//   6. Identidad de puntero           → is_same
//   7. En uso real                    → filtros, sets, dedup

@include("lib/std.cyn")

var g_pass int = 0
var g_fail int = 0

func section(t string) { println(""); print("═══ "); println(t) }
func check_bool(got bool, want bool, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); println(l) }
}
func check(got int, want int, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); print(l); print(": got="); print_int(got); print(" want="); println_int(want) }
}

// ─── Tipos ──────────────────────────────────────────────────────

type Point struct {
    x int
    y int
}

type Named struct {
    id   int
    name string
    done bool
}

type Segment struct {
    from Point
    to   Point
}

type Bounds struct {
    min Point
    max Point
    tag int
}

type Vec3 struct {
    data [3]int
}

type Poly struct {
    first Segment
    last  Segment
    count int
}

// ─── 1. Structs primitivos ──────────────────────────────────────

func session_primitives() {
    section("1. Structs con campos primitivos")

    var a = Point{x: 1, y: 2}
    var b = Point{x: 1, y: 2}
    var c = Point{x: 1, y: 3}
    var d = Point{x: 9, y: 2}

    check_bool(a == b, true,  "a == b (mismo contenido)")
    check_bool(a == c, false, "a != c (difiere y)")
    check_bool(a == d, false, "a != d (difiere x)")
    check_bool(a != c, true,  "a != c")
    check_bool(a != b, false, "a != b (falso, son iguales)")

    // Zero value
    // `var p Point` sin init es null, no un struct con campos en cero.
    // La comparación respeta eso: null == null, null ≠ objeto.
    var z1 Point
    var z2 Point
    var z3 = Point{x: 0, y: 0}
    check_bool(z1 == z2, true,  "z1 == z2 (ambos null)")
    check_bool(z1 == z3, false, "z1 != z3 (null ≠ objeto)")
}

// ─── 2. Structs con strings ─────────────────────────────────────

func session_strings() {
    section("2. Structs con string")

    var a = Named{id: 1, name: "alice", done: false}
    var b = Named{id: 1, name: "alice", done: false}
    var c = Named{id: 1, name: "bob",   done: false}
    var d = Named{id: 2, name: "alice", done: false}
    var e = Named{id: 1, name: "alice", done: true}

    check_bool(a == b, true,  "a == b (todo igual)")
    check_bool(a == c, false, "a != c (name difiere)")
    check_bool(a == d, false, "a != d (id difiere)")
    check_bool(a == e, false, "a != e (done difiere)")
    check_bool(a != c, true,  "a != c")
}

// ─── 3. Structs anidados ────────────────────────────────────────

func session_nested() {
    section("3. Structs anidados")

    var s1 = Segment{from: Point{x: 0, y: 0}, to: Point{x: 1, y: 1}}
    var s2 = Segment{from: Point{x: 0, y: 0}, to: Point{x: 1, y: 1}}
    var s3 = Segment{from: Point{x: 0, y: 0}, to: Point{x: 1, y: 2}}
    var s4 = Segment{from: Point{x: 9, y: 0}, to: Point{x: 1, y: 1}}

    check_bool(s1 == s2, true,  "s1 == s2")
    check_bool(s1 == s3, false, "s1 != s3 (difiere 'to')")
    check_bool(s1 == s4, false, "s1 != s4 (difiere 'from')")

    // Doble anidamiento.
    var p1 = Poly{
        first: Segment{from: Point{x: 0, y: 0}, to: Point{x: 1, y: 1}},
        last:  Segment{from: Point{x: 2, y: 2}, to: Point{x: 3, y: 3}},
        count: 4,
    }
    var p2 = Poly{
        first: Segment{from: Point{x: 0, y: 0}, to: Point{x: 1, y: 1}},
        last:  Segment{from: Point{x: 2, y: 2}, to: Point{x: 3, y: 3}},
        count: 4,
    }
    var p3 = Poly{
        first: Segment{from: Point{x: 0, y: 0}, to: Point{x: 1, y: 1}},
        last:  Segment{from: Point{x: 2, y: 2}, to: Point{x: 3, y: 9}},
        count: 4,
    }
    var p4 = Poly{
        first: Segment{from: Point{x: 0, y: 0}, to: Point{x: 1, y: 1}},
        last:  Segment{from: Point{x: 2, y: 2}, to: Point{x: 3, y: 3}},
        count: 5,
    }

    check_bool(p1 == p2, true,  "p1 == p2 (doblemente anidado)")
    check_bool(p1 == p3, false, "p1 != p3 (difiere en profundo)")
    check_bool(p1 == p4, false, "p1 != p4 (difiere count)")
}

// ─── 4. Structs con arrays inline ───────────────────────────────

func session_arrays() {
    section("4. Structs con arrays inline")

    var v1 = Vec3{data: [1, 2, 3]}
    var v2 = Vec3{data: [1, 2, 3]}
    var v3 = Vec3{data: [1, 2, 9]}
    var v4 = Vec3{data: [9, 2, 3]}

    check_bool(v1 == v2, true,  "v1 == v2")
    check_bool(v1 == v3, false, "v1 != v3 (difiere el último)")
    check_bool(v1 == v4, false, "v1 != v4 (difiere el primero)")

    // Combinado: array de structs con array adentro.
    var b1 = Bounds{
        min: Point{x: 0, y: 0},
        max: Point{x: 10, y: 10},
        tag: 42,
    }
    var b2 = Bounds{
        min: Point{x: 0, y: 0},
        max: Point{x: 10, y: 10},
        tag: 42,
    }
    var b3 = Bounds{
        min: Point{x: 0, y: 0},
        max: Point{x: 10, y: 11},
        tag: 42,
    }

    check_bool(b1 == b2, true,  "b1 == b2")
    check_bool(b1 == b3, false, "b1 != b3 (max.y difiere)")
}

// ─── 5. nulls dentro de structs ─────────────────────────────────

func session_nulls() {
    section("5. nulls dentro de structs")

    var s1 = Segment{from: null, to: null}
    var s2 = Segment{from: null, to: null}
    var s3 = Segment{from: Point{x: 1, y: 2}, to: null}
    var s4 = Segment{from: null, to: Point{x: 3, y: 4}}
    var s5 = Segment{from: Point{x: 1, y: 2}, to: null}

    check_bool(s1 == s2, true,  "s1 == s2 (ambos nulls)")
    check_bool(s1 == s3, false, "s1 != s3 (from no-null)")
    check_bool(s1 == s4, false, "s1 != s4 (to no-null)")
    check_bool(s3 == s4, false, "s3 != s4 (nulls en distinto lado)")
    check_bool(s3 == s5, true,  "s3 == s5 (from igual, to null)")
}

// ─── 6. Identidad de puntero (is_same) ──────────────────────────

func session_identity() {
    section("6. is_same — identidad de puntero")

    var a = Point{x: 1, y: 2}
    var b = Point{x: 1, y: 2}   // mismo contenido, objeto distinto
    var c = a                    // alias: mismo objeto

    check_bool(a == b, true,   "a == b (contenido)")
    check_bool(a == c, true,   "a == c (contenido)")

    check_bool(is_same(a, b), false, "!is_same(a, b) (objetos distintos)")
    check_bool(is_same(a, c), true,  "is_same(a, c) (mismo objeto)")

    // Mutar a → afecta a c (alias), no a b.
    a.x = 99
    check(c.x, 99, "c.x = 99 (ve la mutación de a)")
    check(b.x, 1,  "b.x = 1 (no afectado)")

    check_bool(a == b, false, "tras mutar a, a != b (contenido)")
    check_bool(is_same(a, c), true, "a y c siguen siendo el mismo objeto")

    // null.
    var n Point = null
    check_bool(is_same(n, null), true,  "is_same(null, null)")
    check_bool(is_same(a, null), false, "!is_same(a, null)")
}

// ─── 7. Uso real: filtro, dedup ─────────────────────────────────

func contains(arr []Point, p Point) bool {
    for q in arr {
        if q == p { return true }
    }
    return false
}

func count_eq(arr []Point, p Point) int {
    var n int = 0
    for q in arr {
        if q == p { n = n + 1 }
    }
    return n
}

func append_point(arr []Point, p Point) []Point {
    var n int = len(arr)
    var new_arr []Point = make([]Point, n + 1)
    var i int = 0
    for i < n {
        new_arr[i] = arr[i]
        i = i + 1
    }
    new_arr[n] = p
    return new_arr
}

func session_use() {
    section("7. Uso real: filtros y dedup")

    region {
        var xs []Point = []
        xs = append_point(xs, Point{x: 1, y: 2})
        xs = append_point(xs, Point{x: 3, y: 4})
        xs = append_point(xs, Point{x: 1, y: 2})   // duplicado por contenido
        xs = append_point(xs, Point{x: 5, y: 6})

        check(len(xs), 4, "4 elementos")
        check_bool(contains(xs, Point{x: 3, y: 4}), true,  "contiene {3,4}")
        check_bool(contains(xs, Point{x: 9, y: 9}), false, "no contiene {9,9}")

        // Contar duplicados por contenido.
        check(count_eq(xs, Point{x: 1, y: 2}), 2, "2 elementos con {1,2}")
        check(count_eq(xs, Point{x: 3, y: 4}), 1, "1 elemento con {3,4}")
    }
}

// ─── MAIN ───────────────────────────────────────────────────────

func main() {
    println("cyann — STRUCT COMPARISON")
    println("══════════════════════════════════════════════")

    session_primitives()
    session_strings()
    session_nested()
    session_arrays()
    session_nulls()
    session_identity()
    session_use()

    println("")
    println("══════════════════════════════════════════════")
    print("Pasan: ");  println_int(g_pass)
    print("Fallan: "); println_int(g_fail)
    print("Total: ");  println_int(g_pass + g_fail)

    if g_fail == 0 { println("TODO OK") }
    else { println("HAY FALLOS"); exit(1) }
}

main()