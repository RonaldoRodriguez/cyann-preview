// prueba.cyn
@include("lib/std.cyn")

func contador() fn() int {
    var counter = 0
    return func() int {
        counter++
        return counter
    }
}

func main() {
    var c = contador()
    print_int(c())   // 1
    println("")
    print_int(c())   // 2
    println("")
    print_int(c())   // 3
    println("")
}

main()