// control_flow.cyn — Condiciones, scopes, formas de for y switch.

@include("lib/std.cyn")

var g_pass int = 0
var g_fail int = 0

func check(got int, want int, label string) {
    if got == want {
        g_pass = g_pass + 1
        println("  ok   " + label)
    } else {
        g_fail = g_fail + 1
        println("  FAIL " + label)
    }
}

func classify(value int) int {
    if value < 0 {
        return -1
    } else if value == 0 {
        return 0
    } else {
        return 1
    }
}

func count_with_classic_for(limit int) int {
    var count int = 0
    for var i = 0; i < limit; i++ {
        if i == 2 { continue }
        count = count + 1
    }
    return count
}

func sum_with_condition_loop(limit int) int {
    var index int = 0
    var sum int = 0
    for index < limit {
        sum = sum + index
        index++
    }
    return sum
}

func first_multiple_of_seven() int {
    var value int = 1
    for {
        if value % 7 == 0 { break }
        value++
    }
    return value
}

func describe(value int) int {
    switch value {
    case 1, 2, 3:
        return 10
    case 4:
        return 20
    default:
        return 30
    }
}

func main() {
    check(classify(-2), -1, "if negative branch")
    check(classify(0), 0, "else-if branch")
    check(classify(5), 1, "else branch")

    check(count_with_classic_for(5), 4, "classic for, continue and post")
    check(sum_with_condition_loop(5), 10, "condition-only for")
    check(first_multiple_of_seven(), 7, "infinite for with break")
    check(describe(2), 10, "switch with multiple patterns")
    check(describe(4), 20, "switch single pattern")
    check(describe(9), 30, "switch default")

    var shadow int = 100
    if true {
        var shadow int = 7
        check(shadow, 7, "nested lexical scope")
    }
    check(shadow, 100, "outer binding restored after block")

    if g_fail == 0 { println("TODO OK") }
    else { println("HAY FALLOS"); panic("control-flow checks failed") }
}

main()
