// forward_decl.cyn — Prueba forward declarations + recursión mutua.

@include("lib/std.cyn")

var g_pass int = 0
var g_fail int = 0

func section(t string) { println(""); print("═══ "); println(t) }
func check(got int, want int, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); print(l); print(": got="); print_int(got); print(" want="); println_int(want) }
}
func check_bool(got bool, want bool, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); println(l) }
}

// ─── 1. Llamada a función declarada después ─────────────────────

func session_calls_later() {
    section("1. Llamada antes de declaración")

    check(add(2, 3), 5,     "add(2,3) desde caller definido antes")
    check(sub(10, 4), 6,    "sub(10,4) desde caller definido antes")
    check(mul(6, 7), 42,    "mul(6,7) desde caller definido antes")
}

func add(a int, b int) int { return a + b }
func sub(a int, b int) int { return a - b }
func mul(a int, b int) int { return a * b }

// ─── 2. Recursión mutua ─────────────────────────────────────────

func is_even(n int) bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}

func is_odd(n int) bool {
    if n == 0 { return false }
    return is_even(n - 1)
}

func session_mutual_recursion() {
    section("2. Recursión mutua")

    check_bool(is_even(0), true,   "is_even(0)")
    check_bool(is_even(1), false,  "is_even(1)")
    check_bool(is_even(2), true,   "is_even(2)")
    check_bool(is_even(10), true,  "is_even(10)")
    check_bool(is_odd(0), false,   "is_odd(0)")
    check_bool(is_odd(1), true,    "is_odd(1)")
    check_bool(is_odd(7), true,    "is_odd(7)")
    check_bool(is_odd(8), false,   "is_odd(8)")

    check_bool(is_even(100), true, "is_even(100)")
    check_bool(is_odd(101), true,  "is_odd(101)")
}

// ─── MAIN ───────────────────────────────────────────────────────

func main() {
    println("cyann — FORWARD DECLARATIONS + MUTUAL RECURSION")
    println("══════════════════════════════════════════════")

    session_calls_later()
    session_mutual_recursion()

    println("")
    println("══════════════════════════════════════════════")
    print("Pasan: ");  println_int(g_pass)
    print("Fallan: "); println_int(g_fail)
    print("Total: ");  println_int(g_pass + g_fail)

    if g_fail == 0 { println("TODO OK") }
    else { println("HAY FALLOS"); exit(1) }
}

main()