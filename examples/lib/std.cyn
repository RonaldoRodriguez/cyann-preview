// std.cyn — Utilidades básicas para programas Cyann que usan WASI.
//
// Uso desde un archivo de examples/:
//     @include("lib/std.cyn")
//
// La biblioteca combina salida WASI, conversión básica, helpers numéricos
// y utilidades de strings. Los enteros `int` son de 32 bits en wasm32.

import host("wasi_snapshot_preview1", "fd_write")
func _wasi_fd_write(fd int, iovs int, iovs_len int, nwritten int) int

import host("wasi_snapshot_preview1", "proc_exit")
func _wasi_proc_exit(rval int)

var _iovec int = arena_alloc(8)
var _nwrite int = arena_alloc(4)

func _write(fd int, ptr int, length int) {
    mem_write32(_iovec, ptr)
    mem_write32(_iovec + 4, length)
    _wasi_fd_write(fd, _iovec, 1, _nwrite)
}

func print(value string) {
    _write(1, value, str_len(value))
}

func print(value int) {
    print_int(value)
}

func print(value bool) {
    print_bool(value)
}

func println(value string) {
    print(value)
    print("\n")
}

func println(value int) {
    println_int(value)
}

func println(value bool) {
    println_bool(value)
}

func eprint(value string) {
    _write(2, value, str_len(value))
}

func eprintln(value string) {
    eprint(value)
    eprint("\n")
}

func print_char(value int) {
    mem_write8(_nwrite, value)
    _write(1, _nwrite, 1)
}

func _print_int(fd int, value int) {
    region {
        var text string = str_from_int(value)
        _write(fd, text, str_len(text))
    }
}

func print_int(value int) {
    _print_int(1, value)
}

func println_int(value int) {
    print_int(value)
    print_char(10)
}

func eprint_int(value int) {
    _print_int(2, value)
}

func exit(code int) {
    _wasi_proc_exit(code)
}

func panic(message string) {
    eprintln(message)
    exit(1)
}

func assert(condition bool) {
    if !condition {
        panic("assertion failed")
    }
}

func min(a int, b int) int {
    if a < b { return a }
    return b
}

func max(a int, b int) int {
    if a > b { return a }
    return b
}

func abs(value int) int {
    if value < 0 { return -value }
    return value
}

func clamp(value int, low int, high int) int {
    if value < low { return low }
    if value > high { return high }
    return value
}

func sign(value int) int {
    if value < 0 { return -1 }
    if value > 0 { return 1 }
    return 0
}

func int_is_even(value int) bool {
    return value % 2 == 0
}

func int_is_odd(value int) bool {
    return value % 2 != 0
}

func min(a f32, b f32) f32 {
    if a < b { return a }
    return b
}

func max(a f32, b f32) f32 {
    if a > b { return a }
    return b
}

func clamp(value f32, low f32, high f32) f32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

func abs(value f32) f32 {
    if value < 0.0 { return -value }
    return value
}

func min(a f64, b f64) f64 {
    if a < b { return a }
    return b
}

func max(a f64, b f64) f64 {
    if a > b { return a }
    return b
}

func clamp(value f64, low f64, high f64) f64 {
    if value < low { return low }
    if value > high { return high }
    return value
}

func abs(value f64) f64 {
    if value < 0.0 { return -value }
    return value
}

func print_bool(value bool) {
    if value { print("true") }
    else { print("false") }
}

func println_bool(value bool) {
    print_bool(value)
    print_char(10)
}

func str_from_bool(value bool) string {
    if value { return "true" }
    return "false"
}

func str_is_empty(value string) bool {
    return str_len(value) == 0
}

func str_is_not_empty(value string) bool {
    return str_len(value) != 0
}

func digit_to_str(digit int) string {
    switch digit {
    case 0: return "0"
    case 1: return "1"
    case 2: return "2"
    case 3: return "3"
    case 4: return "4"
    case 5: return "5"
    case 6: return "6"
    case 7: return "7"
    case 8: return "8"
    case 9: return "9"
    }
    return "?"
}

func str_from_int(value int) string {
    if value == 0 { return "0" }

    var negative bool = value < 0
    if value > 0 {
        value = -value
    }

    var result string = ""
    for value < 0 {
        var digit int = 0 - (value % 10)
        result = digit_to_str(digit) + result
        value = value / 10
    }

    if negative { return "-" + result }
    return result
}
