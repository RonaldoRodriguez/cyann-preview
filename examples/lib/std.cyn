// std.cyn — Utilidades básicas para programas Cyann que usan WASI.
//
// Uso desde un archivo de examples/:
//     import "lib/std.cyn" as std
//     std::println("hola")
//
// La biblioteca combina salida WASI, conversión básica, helpers numéricos
// y utilidades de strings. Los enteros `int` son de 32 bits en wasm32.

import host("wasi_snapshot_preview1", "fd_write")
func _wasi_fd_write(fd int, iovs *int, iovs_len int, nwritten *int) int

import host("wasi_snapshot_preview1", "proc_exit")
func _wasi_proc_exit(rval int)


type IoVec struct { data int; len int }
var _iovec *IoVec = arena_for_type(IoVec)
var _nwrite *int = arena_for_type(int)

func _write(fd int, ptr *int, length int) {
    _iovec.data = ptr as int
    _iovec.len = length
    _wasi_fd_write(fd, _iovec, 1, _nwrite)
}

export func print(value string) {
    _write(1, value as *int, str_len(value))
}

export func print(value int) {
    print_int(value)
}

export func print(value bool) {
    print_bool(value)
}

export func println(value string) {
    print(value)
    print("\n")
}

export func println(value int) {
    println_int(value)
}

export func println(value bool) {
    println_bool(value)
}

export func println() {
    print("\n")
}

export func println(values ...string) {
    for value in values {
        print(value)
    }
    print("\n")
}

export func println(values ...int) {
    for value in values {
        print_int(value)
    }
    print("\n")
}

export func println(values ...bool) {
    for value in values {
        print_bool(value)
    }
    print("\n")
}

export func eprint(value string) {
    _write(2, value as *int, str_len(value))
}

export func eprintln(value string) {
    eprint(value)
    eprint("\n")
}

export func print_char(value int) {
    __unsafe__mem_write8(_nwrite, value, 0)
    _write(1, _nwrite, 1)
}

func _print_int(fd int, value int) {
    region {
        var text string = str_from_int(value)
        _write(fd, text as *int, str_len(text))
    }
}

export func print_int(value int) {
    _print_int(1, value)
}

export func println_int(value int) {
    print_int(value)
    print_char(10)
}

export func eprint_int(value int) {
    _print_int(2, value)
}

export func exit(code int) {
    _wasi_proc_exit(code)
}

export func panic(message string) {
    eprintln(message)
    exit(1)
}

export func assert(condition bool) {
    if !condition {
        panic("assertion failed")
    }
}

export func min(a int, b int) int {
    if a < b { return a }
    return b
}

export func max(a int, b int) int {
    if a > b { return a }
    return b
}

export func abs(value int) int {
    if value < 0 { return -value }
    return value
}

export func clamp(value int, low int, high int) int {
    if value < low { return low }
    if value > high { return high }
    return value
}

export func sign(value int) int {
    if value < 0 { return -1 }
    if value > 0 { return 1 }
    return 0
}

export func int_is_even(value int) bool {
    return value % 2 == 0
}

export func int_is_odd(value int) bool {
    return value % 2 != 0
}

export func min(a f32, b f32) f32 {
    if a < b { return a }
    return b
}

export func max(a f32, b f32) f32 {
    if a > b { return a }
    return b
}

export func clamp(value f32, low f32, high f32) f32 {
    if value < low { return low }
    if value > high { return high }
    return value
}

export func abs(value f32) f32 {
    if value < 0.0 { return -value }
    return value
}

export func min(a f64, b f64) f64 {
    if a < b { return a }
    return b
}

export func max(a f64, b f64) f64 {
    if a > b { return a }
    return b
}

export func clamp(value f64, low f64, high f64) f64 {
    if value < low { return low }
    if value > high { return high }
    return value
}

export func abs(value f64) f64 {
    if value < 0.0 { return -value }
    return value
}

export func print_bool(value bool) {
    if value { print("true") }
    else { print("false") }
}

export func println_bool(value bool) {
    print_bool(value)
    print_char(10)
}

export func str_from_bool(value bool) string {
    if value { return "true" }
    return "false"
}

export func str_is_empty(value string) bool {
    return str_len(value) == 0
}

export func str_is_not_empty(value string) bool {
    return str_len(value) != 0
}

export func digit_to_str(digit int) string {
    switch digit {
    case 0: return "0"
    case 1: return "1"
    case 2: return "2"
    case 3: return "3"
    case 4: return "4"
    case 5: return "5"
    case 6: return "6"
    case 7: return "7"
    case 8: return "8"
    case 9: return "9"
    }
    return "?"
}

export func str_from_int(value int) string {
    if value == 0 { return "0" }

    var negative bool = value < 0
    if value > 0 {
        value = -value
    }

    var result string = ""
    for value < 0 {
        var digit int = 0 - (value % 10)
        result = digit_to_str(digit) + result
        value = value / 10
    }

    if negative { return "-" + result }
    return result
}
