// nested_struct_eq.cyn — Equality estructural de structs anidados.

@include("lib/std.cyn")

var g_pass int = 0
var g_fail int = 0

func section(t string) { println(""); print("═══ "); println(t) }
func check_bool(got bool, want bool, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); println(l) }
}
func check(got int, want int, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); print(l); print(": got="); print_int(got); print(" want="); println_int(want) }
}

// ─── Tipos anidados ─────────────────────────────────────────────

type Pt struct {
    x int
    y int
}

type Line struct {
    a Pt
    b Pt
}

type Poly struct {
    first Line
    tag   int
    last  Line
}

// Struct con string dentro de un anidado.
type Named struct {
    id   int
    name string
}

type Wrapper struct {
    inner Named
    count int
}

// ─── 1. Un nivel de anidamiento ─────────────────────────────────

func session_one_level() {
    section("1. Un nivel de anidamiento (Line / Pt)")

    var l1 = Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}}
    var l2 = Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}}
    var l3 = Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 5}}
    var l4 = Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}}

    check_bool(l1 == l2, true,  "l1 == l2 (mismo contenido, distintos ptrs)")
    check_bool(l1 == l3, false, "l1 != l3 (difiere el segundo punto)")
    check_bool(l1 != l3, true,  "l1 != l3")
    check_bool(l1 == l4, true,  "l1 == l4")

    // Los punteros internos son distintos.
    // Semántica: `struct == struct` es equality estructural, no
    // identidad de puntero. `l1.a` y `l2.a` son instancias distintas
    // de `Pt` con el mismo contenido → son == por diseño.
    check_bool(l1.a == l2.a, true,  "l1.a == l2.a (equality estructural)")
    check_bool(l1.a == l1.a, true,  "l1.a == l1.a (trivial)")
    check_bool(l1.a == l3.a, true,  "l1.a == l3.a (mismo contenido)")
    check_bool(l1.a == l3.b, false, "l1.a != l3.b (contenido distinto)")

    check(l1.a.x, 1, "l1.a.x")
    check(l2.a.x, 1, "l2.a.x")
}

// ─── 2. Nulls dentro de structs anidados ────────────────────────

func session_nulls() {
    section("2. Nulls dentro de structs")

    var l1 = Line{a: null, b: null}
    var l2 = Line{a: null, b: null}
    var l3 = Line{a: Pt{x: 1, y: 2}, b: null}
    var l4 = Line{a: null, b: Pt{x: 3, y: 4}}

    check_bool(l1 == l2, true,  "l1 == l2 (ambos con nulls)")
    check_bool(l1 == l3, false, "l1 != l3 (l3 tiene a no-null)")
    check_bool(l1 == l4, false, "l1 != l4 (l4 tiene b no-null)")
    check_bool(l3 == l4, false, "l3 != l4 (nulls en posiciones distintas)")

    var l5 = Line{a: Pt{x: 1, y: 2}, b: null}
    check_bool(l3 == l5, true, "l3 == l5 (a idénticos, b null)")
}

// ─── 3. Anidamiento doble ───────────────────────────────────────

func session_two_levels() {
    section("3. Doble anidamiento (Poly → Line → Pt)")

    var p1 = Poly{
        first: Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}},
        tag:   10,
        last:  Line{a: Pt{x: 5, y: 6}, b: Pt{x: 7, y: 8}},
    }
    var p2 = Poly{
        first: Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}},
        tag:   10,
        last:  Line{a: Pt{x: 5, y: 6}, b: Pt{x: 7, y: 8}},
    }
    var p3 = Poly{
        first: Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}},
        tag:   10,
        last:  Line{a: Pt{x: 5, y: 6}, b: Pt{x: 7, y: 9}},
    }
    var p4 = Poly{
        first: Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}},
        tag:   99,
        last:  Line{a: Pt{x: 5, y: 6}, b: Pt{x: 7, y: 8}},
    }

    check_bool(p1 == p2, true,  "p1 == p2 (todo idéntico)")
    check_bool(p1 == p3, false, "p1 != p3 (difiere un Pt interno)")
    check_bool(p1 == p4, false, "p1 != p4 (difiere el tag)")
    check_bool(p1 != p3, true,  "p1 != p3")
}

// ─── 4. Struct con string adentro ───────────────────────────────

func session_string_field() {
    section("4. Struct con string dentro de anidamiento")

    var w1 = Wrapper{inner: Named{id: 1, name: "alice"}, count: 5}
    var w2 = Wrapper{inner: Named{id: 1, name: "alice"}, count: 5}
    var w3 = Wrapper{inner: Named{id: 1, name: "bob"},   count: 5}
    var w4 = Wrapper{inner: Named{id: 2, name: "alice"}, count: 5}
    var w5 = Wrapper{inner: Named{id: 1, name: "alice"}, count: 6}

    check_bool(w1 == w2, true,  "w1 == w2")
    check_bool(w1 == w3, false, "w1 != w3 (name difiere)")
    check_bool(w1 == w4, false, "w1 != w4 (id difiere)")
    check_bool(w1 == w5, false, "w1 != w5 (count difiere)")
}

// ─── 5. En uso real: filtro ─────────────────────────────────────

func count_matching(arr []Line, target Line) int {
    var c int = 0
    for l in arr {
        if (l == target) { c = c + 1 }
    }
    return c
}

func session_use() {
    section("5. Filtro con equality anidada")

    var arr []Line = []
    arr = append_line(arr, Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}})
    arr = append_line(arr, Line{a: Pt{x: 9, y: 9}, b: Pt{x: 9, y: 9}})
    arr = append_line(arr, Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}})
    arr = append_line(arr, Line{a: null, b: null})

    var target = Line{a: Pt{x: 1, y: 2}, b: Pt{x: 3, y: 4}}
    check(count_matching(arr, target), 2, "2 Line{1,2 -> 3,4}")

    var target_null = Line{a: null, b: null}
    check(count_matching(arr, target_null), 1, "1 Line{null, null}")
}

func append_line(arr []Line, l Line) []Line {
    var n int = len(arr)
    var new_arr []Line = make([]Line, n + 1)
    var i int = 0
    for i < n {
        new_arr[i] = arr[i]
        i = i + 1
    }
    new_arr[n] = l
    return new_arr
}
// check_bool(l1.a == l2.a, false, "l1.a y l2.a son punteros distintos")
// ─── MAIN ───────────────────────────────────────────────────────

func main() {
    println("cyann — NESTED STRUCT EQUALITY")
    println("══════════════════════════════════════════════")

    session_one_level()
    session_nulls()
    session_two_levels()
    session_string_field()
    session_use()

    println("")
    println("══════════════════════════════════════════════")
    print("Pasan: ");  println_int(g_pass)
    print("Fallan: "); println_int(g_fail)
    print("Total: ");  println_int(g_pass + g_fail)

    if g_fail == 0 { println("TODO OK") }
    else { println("HAY FALLOS"); exit(1) }
}

main()