// dce_demo.cyn — Verifica que DCE elimina código no usado.

@include("lib/std.cyn")

var g_pass int = 0
var g_fail int = 0

func section(t string) { println(""); print("═══ "); println(t) }
func check(got int, want int, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); print(l); print(": got="); print_int(got); print(" want="); println_int(want) }
}
func check_bool(got bool, want bool, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); println(l) }
}

// ─── Código muerto (nunca referenciado) ─────────────────────────

func unused_heavy_computation(x int) int {
    var acc int = 0
    var i int = 0
    for i < 1000 {
        acc = acc + i * x
        i = i + 1
    }
    return acc
}

func unused_dead_end(a int, b int, c int) int {
    var t int = a + b
    t = t * c
    t = t - a
    t = t / (b + 1)
    return t
}

func unused_never_called(s string) string {
    return s + s + s + s
}

func unused_recursive(n int) int {
    if n <= 0 { return 0 }
    return n + unused_recursive(n - 1)
}

// ─── Código vivo ────────────────────────────────────────────────

func square(x int) int { return x * x }

func sum_squares(n int) int {
    var total int = 0
    var i int = 1
    for i <= n {
        total = total + square(i)
        i = i + 1
    }
    return total
}

// Función viva solo porque se pasa como callback.
func double(x int) int { return x * 2 }

func apply(f fn(int) int, x int) int { return f(x) }

// ─── Sesiones ───────────────────────────────────────────────────

func session_alive() {
    section("1. Código vivo")

    check(square(7), 49, "square(7)")
    check(sum_squares(5), 55, "sum_squares(5) = 1+4+9+16+25")
    check(apply(double, 21), 42, "apply(double, 21)")
    check(apply(func(x int) int { return x + 1 }, 41), 42, "lambda in-situ")
}

func session_strings() {
    section("2. Strings vivos")
    var s string = "hello"
    check_bool(s == "hello", true, "s == 'hello'")
    check(str_len(s), 5, "str_len(s)")
}

// ─── MAIN ───────────────────────────────────────────────────────

func main() {
    println("cyann — DEAD CODE ELIMINATION")
    println("══════════════════════════════════════════════")

    session_alive()
    session_strings()

    println("")
    println("══════════════════════════════════════════════")
    print("Pasan: ");  println_int(g_pass)
    print("Fallan: "); println_int(g_fail)
    print("Total: ");  println_int(g_pass + g_fail)

    if g_fail == 0 { println("TODO OK") }
    else { println("HAY FALLOS"); exit(1) }
}

main()