// array_eq_dce.cyn — Equality de arrays en structs + string pool DCE.

@include("lib/std.cyn")

var g_pass int = 0
var g_fail int = 0

func section(t string) { println(""); print("═══ "); println(t) }
func check_bool(got bool, want bool, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); println(l) }
}
func check(got int, want int, l string) {
    if got == want { g_pass = g_pass + 1; print("  ok   "); println(l) }
    else { g_fail = g_fail + 1; print("  FAIL "); print(l); print(": got="); print_int(got); print(" want="); println_int(want) }
}

// ─── Structs con arrays ────────────────────────────────────────

type Vec3 struct {
    data [3]int
}

type Matrix struct {
    rows [2]Vec3   // array de structs
}

type Meta struct {
    tag    int
    values [4]int
    label  string
}

// ─── 1. Array de primitivos ─────────────────────────────────────

func session_array_of_prims() {
    section("1. Array de primitivos en struct")

    var v1 = Vec3{data: [1, 2, 3]}
    var v2 = Vec3{data: [1, 2, 3]}
    var v3 = Vec3{data: [1, 2, 4]}
    var v4 = Vec3{data: [1, 2, 3]}

    check_bool(v1 == v2, true,  "v1 == v2")
    check_bool(v1 == v3, false, "v1 != v3 (difiere el último)")
    check_bool(v1 != v3, true,  "v1 != v3")
    check_bool(v1 == v4, true,  "v1 == v4")

    // Diferencia en la primera posición.
    var v5 = Vec3{data: [9, 2, 3]}
    check_bool(v1 == v5, false, "v1 != v5 (difiere el primero)")
}

// ─── 2. Array de structs ────────────────────────────────────────

func session_array_of_structs() {
    section("2. Array de structs")

    var m1 = Matrix{rows: [Vec3{data: [1, 2, 3]}, Vec3{data: [4, 5, 6]}]}
    var m2 = Matrix{rows: [Vec3{data: [1, 2, 3]}, Vec3{data: [4, 5, 6]}]}
    var m3 = Matrix{rows: [Vec3{data: [1, 2, 3]}, Vec3{data: [4, 5, 7]}]}
    var m4 = Matrix{rows: [Vec3{data: [9, 2, 3]}, Vec3{data: [4, 5, 6]}]}

    check_bool(m1 == m2, true,  "m1 == m2 (matrices idénticas)")
    check_bool(m1 == m3, false, "m1 != m3 (difiere un elemento del 2do Vec3)")
    check_bool(m1 == m4, false, "m1 != m4 (difiere un elemento del 1er Vec3)")
}

// ─── 3. Struct mixto: int + array + string ──────────────────────

func session_mixed() {
    section("3. Struct mixto")

    var a = Meta{tag: 1, values: [10, 20, 30, 40], label: "hello"}
    var b = Meta{tag: 1, values: [10, 20, 30, 40], label: "hello"}
    var c = Meta{tag: 1, values: [10, 20, 30, 41], label: "hello"}
    var d = Meta{tag: 2, values: [10, 20, 30, 40], label: "hello"}
    var e = Meta{tag: 1, values: [10, 20, 30, 40], label: "world"}

    check_bool(a == b, true,  "a == b")
    check_bool(a == c, false, "a != c (array difiere)")
    check_bool(a == d, false, "a != d (tag difiere)")
    check_bool(a == e, false, "a != e (string difiere)")
}

// ─── 4. Código muerto con strings ───────────────────────────────

// Estas funciones usan strings que NUNCA se referencian desde código
// vivo. DCE debería eliminarlas, y el string pool debería achicarse.
func unused_string_heavy(n int) string {
    var unused_msg string = "esta cadena nunca se usa en codigo vivo"
    var other_dead string = "otra cadena muerta para eliminar del pool"
    var _ignored int = n
    return unused_msg + other_dead
}

func unused_json_builder(id int) string {
    var open string = "{"
    var close string = "}"
    var key string = "\"id\""
    var colon string = ":"
    var _x int = id
    return open + key + colon + close
}

// ─── MAIN ───────────────────────────────────────────────────────

func main() {
    println("cyann — ARRAY EQ + STRING DCE")
    println("══════════════════════════════════════════════")

    session_array_of_prims()
    session_array_of_structs()
    session_mixed()

    println("")
    println("══════════════════════════════════════════════")
    print("Pasan: ");  println_int(g_pass)
    print("Fallan: "); println_int(g_fail)
    print("Total: ");  println_int(g_pass + g_fail)

    if g_fail == 0 { println("TODO OK") }
    else { println("HAY FALLOS"); exit(1) }
}

main()